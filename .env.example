# ============================================================
# assistant-ia-api — Variables d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne commitez JAMAIS le fichier .env dans Git !
# ============================================================

# --- Application ---
APP_NAME=assistant-ia-api
APP_VERSION=1.0.0
DEBUG=False

# --- Serveur ---
HOST=0.0.0.0
PORT=8000

# --- CORS (origines autorisées, séparées par des virgules) ---
# ALLOWED_ORIGINS=http://localhost:3000,https://votre-domaine.com

# --- Sécurité (Étape 2) ---
# Générez une clé sécurisée : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-cette-cle-en-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de données (Étape 2) ---
# SQLite (développement) :
DATABASE_URL=sqlite:///./assistant_ia.db
# PostgreSQL (production) :
# DATABASE_URL=postgresql://user:password@localhost:5432/assistant_ia

# --- Fournisseur IA (Étape 3) ---
AI_PROVIDER=groq

# Groq (Llama, Mixtral)
GROQ_API_KEY=votre_cle_groq

# Gemini (Google)
GEMINI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Ollama / Open Source (Llama, Mistral, Qwen)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5

# Override de modèle (laisser vide pour utiliser le modèle par défaut du fournisseur)
MODEL=

# --- Base de connaissances RAG ---
# Placez les PDF, DOCX, Markdown, TXT ou HTML internes dans data/knowledge/.
# À activer une seule fois si le modèle d'embeddings doit être téléchargé et que
# l'environnement dispose d'un accès réseau autorisé ; sinon le RAG lexical reste actif.
RAG_ALLOW_REMOTE_MODEL_DOWNLOAD=False
